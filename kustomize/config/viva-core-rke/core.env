# A standalone core at UConn PROD (docs/plan-core.md §4b U4), beside the SMS api pod at
# sms.cam.uchc.edu. Every variable is a CoreSettings field; nothing SMS-shaped is read by this pod.
# Same shape as dev's (kustomize/config/viva-core-rke-dev/core.env); the differences are the tree
# (/projects/SMS/viva_core/prod) and the namespace.

OWNER_INSTANCE=core

# --- the SLURM backend: Mantis through the in-cluster haproxy-ssh Service (as the api pod) ---
SLURM_SUBMIT_HOST=haproxy-ssh
SLURM_SUBMIT_USER=svc_vivarium
SLURM_SUBMIT_KEY_PATH=/run/secrets/slurm_submit_key_file/ssh-privatekey
SLURM_SUBMIT_KNOWN_HOSTS=/run/secrets/ssh-known-hosts/known_hosts
# What svc_vivarium's association allows (sacctmgr, 2026-09-26) and what the live prod api pod uses.
SLURM_PARTITION=vcell
SLURM_NODE_LIST=
SLURM_QOS=vcell-services
# Core's own tree on the HPC filesystem, a sibling of SMS's /projects/SMS/sms_api/prod (README.md).
SLURM_LOG_BASE_PATH={"remote_path":"/projects/SMS/viva_core/prod/htclogs"}
SLURM_BASE_PATH={"remote_path":"/projects/SMS/viva_core/prod"}
COMPOSE_IMAGE_BASE_PATH=/projects/SMS/viva_core/prod/compose/images
COMPOSE_SIM_BASE_PATH=/projects/SMS/viva_core/prod/compose/sims
COMPOSE_CONTAINERS_OUTPUT_DIR=/output
COMPOSE_CACHE_BASE_PATH=
# Containers are BUILT in a Kubernetes Job (viva_core/compose/build_k8s.py): the vcell nodes have no
# subuid entry for svc_vivarium. The Job mounts core's own claim on cfs15:/projects at /projects/SMS
# (subPath SMS) and copies the image as appuser (17163:10000 + the tree's groups).
COMPOSE_BUILD_BACKEND=k8s
COMPOSE_BUILD_IMAGE=ghcr.io/apptainer/apptainer:1.3.6
COMPOSE_BUILD_PVC_CLAIM=viva-core-projects-pvc
COMPOSE_BUILD_PVC_MOUNT_PATH=/projects/SMS
COMPOSE_BUILD_PVC_SUB_PATH=SMS
COMPOSE_BUILD_RUN_AS_UID=17163
COMPOSE_BUILD_RUN_AS_GID=10000
COMPOSE_BUILD_SUPPLEMENTAL_GROUPS=10274,10281,10269

# --- the database (D19): its own, `viva_core` on sms-postgres-cluster (the Database CR under
# kustomize/cluster/postgres-cluster/vxrails/); create_all bootstraps it until core's Alembic chain ---
DB_CREATE_ALL=true

# --- object storage: Qumulo S3 (credentials from the core-qumulo-secrets sealed secret, optional) ---
STORAGE_BACKEND=qumulo
STORAGE_QUMULO_ENDPOINT_URL=https://cfs15.cam.uchc.edu:9000
STORAGE_QUMULO_BUCKET=sms-vivarium
STORAGE_QUMULO_VERIFY_SSL=false
STORAGE_LOCAL_CACHE_DIR=/app/.results_cache

# --- environments (D10) ---
ENVIRONMENT_REGISTRY=ghcr.io/vivarium-collective
ENVIRONMENT_REPOSITORY=viva-core-runtime
CORE_RUNTIME_IMAGE=ghcr.io/vivarium-collective/viva-core-runtime:0.1.0

# --- env workers: Kubernetes Jobs in this namespace ---
K8S_JOB_NAMESPACE=sms-api-rke
ENV_WORKER_MODULE_IMAGE=ghcr.io/vivarium-collective/vivarium-workbench:0.3.85
ENV_WORKER_MODULE_PATH=/app/vivarium-workbench/vivarium_workbench
ENV_WORKER_WORKSPACE_PATH=/app/v2ecoli
ENV_WORKER_APP_LABEL=viva-core
ENV_WORKER_SERVICE_ACCOUNT=batch-submit
ENV_WORKER_MEMORY_REQUEST=512Mi
ENV_WORKER_MEMORY_LIMIT=8Gi
