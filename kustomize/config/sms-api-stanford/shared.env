# Compute backend: "slurm" or "batch"
COMPUTE_BACKEND=batch
PUBLIC_MODE=false

# Messaging configuration (Redis)
REDIS_INTERNAL_HOST=smr1p1ccqiaewxyd.xfvggv.ng.0001.usgw1.cache.amazonaws.com
REDIS_INTERNAL_PORT=6379
REDIS_EXTERNAL_HOST=smr1p1ccqiaewxyd.xfvggv.ng.0001.usgw1.cache.amazonaws.com
REDIS_EXTERNAL_PORT=6379
REDIS_CHANNEL=worker.events
REDIS_EMITTER_MAGIC_WORD=redis-emitter-magic-word

# Docker image builds (DooD via AWS Batch)
# Queue names are looked up from CloudFormation by secrets.sh
BUILD_ARM64_QUEUE=smscdk-vecoli-build-arm64
BUILD_AMD64_QUEUE=smscdk-vecoli-build-amd64
BUILD_JOB_DEFINITION=smscdk-vecoli-dind-build
BUILD_GIT_SECRET_ARN=arn:aws-us-gov:secretsmanager:us-gov-west-1:476270107793:secret:vecoli-github-pat

K8S_JOB_NAMESPACE=sms-api-stanford
ECR_ACCOUNT_ID=476270107793
S3_WORK_BUCKET=smscdk-shared-sharedbucket60d199d6-2u7sguagdihi
STORAGE_S3_BUCKET=smscdk-shared-sharedbucket60d199d6-2u7sguagdihi
STORAGE_S3_REGION=us-gov-west-1
BATCH_AMD64_QUEUE=smscdk-vecoli-task-amd64
BATCH_ARM64_QUEUE=smscdk-vecoli-task-arm64
BATCH_TASK_ARCH=arm64

# Ray-on-Batch backend — settings ready, but prod stays COMPUTE_BACKEND=batch above;
# flip to "ray" to activate. Queue/job-def/log-prefix re-resolved by secrets.sh
# (smscdk-ray-batch / smscdk-ray).
RAY_MNP_QUEUE=smscdk-ray-mnp
RAY_MNP_JOB_DEFINITION=smscdk-ray-mnp
# Container-type Batch jobs (item 71 Phase 2): ParCa, per-seed chain-dispatch
# generations, and analysis all route through _submit_container. BOTH keys are
# required -- viva_api/common/capabilities.py:_has_container_jobs gates the
# feature on code AND configuration, so a blank either side makes the deployment
# advertise container jobs as UNAVAILABLE rather than fail at dispatch.
# Verified live before setting: queue ENABLED/VALID, job def rev 1, container
# type, 16 vCPU / 122880 MiB.
RAY_CONTAINER_QUEUE=smscdk-ray-standalone
RAY_CONTAINER_JOB_DEFINITION=smscdk-ray-container
#
# RAY_ARRAY_QUEUE / RAY_ARRAY_JOB_DEFINITION were REMOVED here, not migrated.
# They had no reader: `_submit_array` / `_array_sim_command` /
# `_ensure_array_job_def` were deleted in backlog item 33's rework, which routes
# the canonical sweep to `submit_chain_dispatch_job` instead. A repo-wide grep
# finds RAY_ARRAY_* only in its own Settings declaration, a version.py changelog
# line, and a test fixture that fills the field without asserting on it.
#
# Removing dead config rather than leaving it is deliberate. Config that looks
# live and is not has now bitten this repo three times -- IDENTITY_HEADER
# (deployed under a prefixed name the settings never read), and
# ENV_WORKER_WORKSPACE_PATH (shadowed by a truthy Field default) -- and in each
# case the tell was a variable sitting on a pod that nothing consumed.
RAY_LOG_S3_PREFIX=s3://smscdk-shared-sharedbucket60d199d6-2u7sguagdihi/ray-logs/
RAY_ECR_REPOSITORY=v2ecoli

# -- env workers: run a simulator's prebuilt image as the workbench's env worker
# (vivarium-workbench#942 / REFACTOR-PLAN 2A.8). Hosted builds NO venv; the
# image for a commit IS the execution environment.
#
# The workbench image an env-worker Job stages its worker module out of. MUST
# contain the dial-back transport (workbench#945) -- 0.3.57 and earlier offer
# only --socket-fd, and a worker built from those exits 2 on --connect-to.
# Kept equal to the vivarium-workbench newTag in the SIBLING
# overlays/sms-api-stanford-workbench overlay: the workbench that runs and the
# module a worker stages are the same code, and they must not drift.
#
# NOTE (2026-08-31): that sibling overlay still pins 0.3.55, so this key is
# INERT on prod until the workbench is bumped to 0.3.78 in the same rollout.
# 0.3.55 has no env-worker client and never requests a worker. Do not resolve
# the mismatch by lowering this to 0.3.55 -- see the 0.3.57 note above.
ENV_WORKER_MODULE_IMAGE=ghcr.io/vivarium-collective/vivarium-workbench:0.3.78
# Workspace root INSIDE the simulator image -- its own checkout, which under
# 2A.8 is the environment. Not the PVC (ReadWriteOnce, single-node, and the
# mutable record rather than the environment).
ENV_WORKER_WORKSPACE_PATH=/app/v2ecoli
RAY_NUM_NODES=24
RAY_PARCA_MODE=full
RAY_PARCA_CPUS=8
RAY_N_STEPS=600
RAY_CHUNK=60

# Compose (Ray-on-Batch) — image tag must be a real commit built into the
# `v2ecoli` ECR repo (per submit_build_image_job, the tag is actually an
# sms-ecoli commit despite the repo name). The image tag has NO default (ECR
# is per-commit, no "latest"), so blank makes compose submits fail fast naming
# the setting.
#
# 2026-08-31: was `bfc9198c…`, a stale, unrelated month-old sms-ecoli commit
# (2026-07-26, "raise per-seed memory reservation" — never an ancestor of
# main, no real relation to compose/violacein work; the comment that used to
# sit here even named a THIRD, different hash, `868cf2a3…`, that was never
# the actual set value either — drifted documentation on top of a stale
# value). Reset to `5bb9b92`, sms-ecoli `main` tip as of this deploy —
# includes PR #167 (CD2 Run-4 configs) and #164 (`violacein_production_flux`
# leaf), both needed for issue #166's GovCloud ask. Built via
# `submit_build_image_job` (simulator db_id 76) and independently confirmed
# in ECR (`aws ecr describe-images`, 5.7GB, pushed 2026-08-31T12:41:58-04:00)
# before this value was set — not trusted from the build's own status alone.
#
# 2026-08-31 (this deploy): `5bb9b92` predates sms-ecoli PR #171 — it has the
# WRONG Run-4 config PR #167 introduced by mistake
# (fss_pathway_oe_tnaA_trpR_knockout_carina.json instead of the real
# native_oe screen). Reset to `188da91`, sms-ecoli `main` tip after #171
# merged (2026-08-31T22:51:56Z) — the correct Run-4 config set
# (pathway_expression_carina_final.json + fss_pathway_oe_native_oe_carina.json)
# plus #164's violacein_production_flux leaf, unblocking issue #166's Run 4.
# Built via `atlantis simulator latest` (simulator db_id 77) and
# independently confirmed in ECR (`aws ecr describe-images`, tag `188da91`,
# pushed 2026-08-31T23:07:33Z) before this value was set.
COMPOSE_RAY_IMAGE_TAG=188da91
# Where the commit-keyed ParCa cache is staged before the run; v2ecoli resolves a
# relative "out/cache" against the image WORKDIR (/app/v2ecoli).
COMPOSE_PARCA_CACHE_DIR=/app/v2ecoli/out/cache
# The workspace's own core builder — registers ECOLI_TYPES, without which
# v2ecoli's documents don't resolve on the generic run_pbg core.
COMPOSE_PBG_CORE_BUILDER=v2ecoli.core:build_core
# RAY_NUM_NODES (above) now covers compose runs too -- COMPOSE_RAY_NUM_NODES was a
# second, independent setting feeding the same shared _submit_mnp() call, and its
# existence is exactly why RAY_NUM_NODES got left behind at 4 when the CDK-side
# capacity scale-up to 24 nodes (sms-cdk#29) only ever updated this one. See
# backlog item 26.

MARIMO_API_SERVER=http://api:8000
DEPLOYMENT_NAMESPACE=sms-api-stanford
