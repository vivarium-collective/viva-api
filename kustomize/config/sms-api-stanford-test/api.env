GITHUB_DOCKERCONFIG_PATH=/run/secrets/ghcr/.dockerconfigjson
# The schema belongs to the alembic-migrate Job alone: the app creates nothing at startup.
# (viva_api/simulation/db_startup.py; docs/plan-core.md P0.) /health reports db_at_head.
DB_CREATE_ALL=false
# The core runtime image (docs/plan-core.md P2.3c/d; Dockerfile-core-runtime): the environment a
# task runs in when it asks for `environment=runtime` instead of a simulator's image. Unset = the
# request answers 501. A full image reference, WRITE-ONCE: a new image is a new tag
# (build-core-runtime.yml refuses an existing one). Pulled by Batch from ghcr anonymously -- the
# package is public; proven from this VPC on 2026-09-21 (job 58aaf734, sha256:356405729d9b...).
CORE_RUNTIME_IMAGE=ghcr.io/vivarium-collective/viva-core-runtime:0.1.0
