# A standalone core at UConn dev (docs/plan-core.md §4b U3). Every variable is a CoreSettings
# field (viva_core/settings.py); nothing SMS-shaped is read by this pod.

# This process's role: env-worker tasks are stamped with it and the boot sweep settles only its own.
OWNER_INSTANCE=core

# --- the SLURM backend: Mantis through the in-cluster haproxy-ssh Service (as the api pod) ---
SLURM_SUBMIT_HOST=haproxy-ssh
SLURM_SUBMIT_USER=svc_vivarium
SLURM_SUBMIT_KEY_PATH=/run/secrets/slurm_submit_key_file/ssh-privatekey
SLURM_SUBMIT_KNOWN_HOSTS=/run/secrets/ssh-known-hosts/known_hosts
SLURM_PARTITION=vcell
SLURM_NODE_LIST=
SLURM_QOS=vcell-services
# Core's own tree on the HPC filesystem: a sibling of SMS's /projects/SMS/sms_api/dev, so the two
# never write into each other. The directories must exist (README.md).
SLURM_LOG_BASE_PATH={"remote_path":"/projects/SMS/viva_core/dev/htclogs"}
SLURM_BASE_PATH={"remote_path":"/projects/SMS/viva_core/dev"}
COMPOSE_IMAGE_BASE_PATH=/projects/SMS/viva_core/dev/compose/images
COMPOSE_SIM_BASE_PATH=/projects/SMS/viva_core/dev/compose/sims
COMPOSE_CONTAINERS_OUTPUT_DIR=/output
COMPOSE_CACHE_BASE_PATH=

# --- the database (D19): its own; create_all bootstraps it until core's Alembic chain (P7) ---
DB_CREATE_ALL=true

# --- object storage: Qumulo S3 (credentials from the core-qumulo-secrets sealed secret) ---
STORAGE_BACKEND=qumulo
STORAGE_QUMULO_ENDPOINT_URL=https://cfs15.cam.uchc.edu:9000
STORAGE_QUMULO_BUCKET=sms-vivarium
STORAGE_QUMULO_VERIFY_SSL=false
# Where the SLURM compose service keeps the results archives it fetches: the results-cache emptyDir.
STORAGE_LOCAL_CACHE_DIR=/app/.results_cache

# --- environments (D10): the registry a standalone core selects from, and its runtime image ---
ENVIRONMENT_REGISTRY=ghcr.io/vivarium-collective
ENVIRONMENT_REPOSITORY=viva-core-runtime
CORE_RUNTIME_IMAGE=ghcr.io/vivarium-collective/viva-core-runtime:0.1.0

# --- env workers: Kubernetes Jobs in this namespace, the workbench image as the module source ---
K8S_JOB_NAMESPACE=sms-api-rke-dev
ENV_WORKER_MODULE_IMAGE=ghcr.io/vivarium-collective/vivarium-workbench:0.3.85
ENV_WORKER_MODULE_PATH=/app/vivarium-workbench/vivarium_workbench
ENV_WORKER_WORKSPACE_PATH=/app/v2ecoli
ENV_WORKER_APP_LABEL=viva-core
ENV_WORKER_SERVICE_ACCOUNT=batch-submit
ENV_WORKER_MEMORY_REQUEST=512Mi
ENV_WORKER_MEMORY_LIMIT=8Gi
