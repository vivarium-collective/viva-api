FROM ubuntu:22.04

ARG APP_UID=17163
ARG APP_GID=10000

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:1

# Fix GPG keys and update package lists
# APT::Sandbox::User=root -- without it apt fails EVERY repo with "At least one
# invalid signature was encountered" on Docker Desktop for macOS. It is not the
# network (InRelease arrives byte-identical to the host), not the clock (container
# and host agree), not emulation (it fails on native arm64 too) and not the keys:
# the unprivileged _apt sandbox user cannot read what it needs under this storage
# driver, so gpgv never gets a valid input. Verified 2026-09-15: the same
# apt-get update goes from failing on every repo to "Fetched 47.6 MB in 4s".
RUN rm -rf /var/lib/apt/lists/* && \
    apt-get clean && \
    apt-get -o APT::Sandbox::User=root update --allow-releaseinfo-change && \
    apt-get -o APT::Sandbox::User=root install -y --no-install-recommends \
    build-essential \
    xvfb \
    libxpm4 \
    libxpm-dev \
    libx11-dev \
    libxt-dev \
    libxm4 \
    openssl \
    ca-certificates \
    && groupadd -g $APP_GID appgroup \
    && useradd -m -u $APP_UID -g $APP_GID appuser \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ADD assets/ptools/aic-export-30.0.tar.gz /app/

# Overlay patched vendor files on top of the extracted distribution.
# The archive is ~1 GB, so patching it in place would make the change invisible in
# review and unrevertible in practice; a COPY after the ADD keeps the vendor tarball
# byte-identical and the patch a normal tracked, diffable file.
#   htdocs/sms/sms.js -- tolerant valueType resolution (CovertLabEcoli/sms-ecoli#166)
COPY assets/ptools/overrides/htdocs/sms/sms.js \
     /app/aic-export/pathway-tools/ptools/30.0/install/htdocs/sms/sms.js

RUN mkdir -p /app/ptools && \
    ./aic-export/pathway-tools/ptools/30.0/install/config-ptools /app/ptools

VOLUME ["/app/scratch"]
ENV SERVER_HOST_NAME=ptools.sms-api-eks.svc.cluster.local

EXPOSE 1555
EXPOSE 5008
#
CMD bash -c "\
    Xvfb :1 -screen 0 1024x768x16 & \
    sleep 2 && \
    /app/pathway-tools -www -www-server-hostname ${SERVER_HOST_NAME} -port 1555 -python"
