profiles {
    local {
        process {
            executor = 'local'
        }
    }
    slurm {
        process {
            executor = 'slurm'
            errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        }
        executor.queueSize = 100
        executor.submitRateLimit = '20/min'
    }
    awsbatch {
        // not configured; pass awsbatch params to render it
        process { executor = 'awsbatch' }
    }
    'google-batch' {
        // STUB (untested in v1)
        process { executor = 'google-batch' }
    }
}
